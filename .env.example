# Server-only base URL for the NestJS API. Do not expose secrets with NEXT_PUBLIC_ variables.
# Must include the API's global prefix (`/api`) — every route is mounted under
# it, and without it the app 404s on everything, starting visibly with Google
# sign-in. `lib/auth-server.ts` refuses to load if the path is missing.
API_BASE_URL=http://localhost:4000/api

# Microsoft Clarity project id. Blank turns it off entirely: no script, and the
# CSP stays narrow.
#
# Read at BUILD time as well as at runtime. `next.config.ts` widens the CSP to
# allow `clarity.ms` only when this is set, and Next bakes that policy into the
# routes manifest at build — so a value supplied at runtime alone leaves the tag
# blocked with nothing but a console error to show for it.
#
# Session replay records the DOM, so treat enabling it as a privacy decision and
# not just a build flag.
CLARITY_PROJECT_ID=

# trigger beta deployment